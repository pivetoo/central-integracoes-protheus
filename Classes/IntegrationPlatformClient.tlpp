#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.cti

// Cliente REST da IntegrationPlatform. Le ZZ_CTIURL/ZZ_CTIKEY por filial.
// Toda resposta vem no envelope {message,data,errors,pagination}.
Class IntegrationPlatformClient

    Private Data cBaseUrl   as Character
    Private Data cApiKey    as Character
    Public  Data cLastError as Character

    Public Method New() Constructor

    Public Method GetActiveCategories() as Array
    Public Method GetIntegrationsByCategory(nCategoryId as Numeric) as Array
    Public Method GetAttributesByIntegration(nIntegrationId as Numeric) as Array
    Public Method GetActiveConnectors() as Array
    Public Method GetConnectorsByIntegration(nIntegrationId as Numeric) as Array
    Public Method CreateConnector(nIntegrationId as Numeric, cName as Character, cSystemApplicationId as Character) as Numeric
    Public Method UpdateConnector(nConnectorId as Numeric, nIntegrationId as Numeric, cName as Character, lActive as Logical) as Logical
    Public Method SaveConnectorAttributeValue(nConnectorId as Numeric, nIntegrationAttributeId as Numeric, cValue as Character, nExistingValueId as Numeric) as Logical
    Public Method GetConnectorAttributeValuesByConnector(nConnectorId as Numeric) as Array

    Private Method DoRequest(cVerb as Character, cPath as Character, cBody as Character) as Object
    Private Method GetData(cVerb as Character, cPath as Character) as Array
    Private Method ErrorFrom(cBody as Character) as Character

EndClass

Method New() Class IntegrationPlatformClient
    ::cBaseUrl   := AllTrim(SuperGetMV("ZZ_CTIURL", .F., ""))
    ::cApiKey    := AllTrim(SuperGetMV("ZZ_CTIKEY", .F., ""))
    ::cLastError := ""
Return Self

// GET /api/integrationcategories/active
Method GetActiveCategories() Class IntegrationPlatformClient
Return ::GetData("GET", "/api/integrationcategories/active")

// GET /api/integrations/category/{id}
Method GetIntegrationsByCategory(nCategoryId) Class IntegrationPlatformClient
Return ::GetData("GET", "/api/integrations/category/" + cValToChar(nCategoryId))

// GET /api/integrationattributes/integration/{id}
// "type" e o FieldType numerico: 1=Texto 2=TextoLongo 3=Numero 4=Decimal
// 5=Logico 6=Data 7=DataHora 8=Lista 9=Arquivo
Method GetAttributesByIntegration(nIntegrationId) Class IntegrationPlatformClient
Return ::GetData("GET", "/api/integrationattributes/integration/" + cValToChar(nIntegrationId))

// GET /api/connectors/active
Method GetActiveConnectors() Class IntegrationPlatformClient
Return ::GetData("GET", "/api/connectors/active")

// GET /api/connectors/integration/{id}
Method GetConnectorsByIntegration(nIntegrationId) Class IntegrationPlatformClient
Return ::GetData("GET", "/api/connectors/integration/" + cValToChar(nIntegrationId))

// GET /api/connectorattributevalues/connector/{id} - pre-carrega o form na edicao
Method GetConnectorAttributeValuesByConnector(nConnectorId) Class IntegrationPlatformClient
Return ::GetData("GET", "/api/connectorattributevalues/connector/" + cValToChar(nConnectorId))

// POST /api/connectors -> Id criado, ou 0 em falha (::cLastError)
Method CreateConnector(nIntegrationId, cName, cSystemApplicationId) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()
    Local oResp
    Local oData
    Local nId := 0

    Default cSystemApplicationId := ""

    oJson["integrationId"] := nIntegrationId
    oJson["name"]          := cName
    If !Empty(cSystemApplicationId)
        oJson["systemApplicationId"] := cSystemApplicationId
    EndIf

    oResp := ::DoRequest("POST", "/api/connectors/Create", oJson:ToJson())
    If oResp != Nil
        oData := oResp["data"]
        If oData != Nil
            nId := oData["id"]
        EndIf
    EndIf
Return nId

// PUT /api/connectors/{id}
Method UpdateConnector(nConnectorId, nIntegrationId, cName, lActive) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()

    oJson["id"]            := nConnectorId
    oJson["integrationId"] := nIntegrationId
    oJson["name"]          := cName
    oJson["isActive"]      := lActive
Return (::DoRequest("PUT", "/api/connectors/Update/" + cValToChar(nConnectorId), oJson:ToJson()) != Nil)

Method SaveConnectorAttributeValue(nConnectorId, nIntegrationAttributeId, cValue, nExistingValueId) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()
    Local oResp

    Default nExistingValueId := 0

    If nExistingValueId > 0
        oJson["id"]                     := nExistingValueId
        oJson["integrationAttributeId"] := nIntegrationAttributeId
        oJson["value"]                  := cValue
        oResp := ::DoRequest("PUT", "/api/connectorattributevalues/Update/" + cValToChar(nExistingValueId), oJson:ToJson())
    Else
        oJson["connectorId"]            := nConnectorId
        oJson["integrationAttributeId"] := nIntegrationAttributeId
        oJson["value"]                  := cValue
        oResp := ::DoRequest("POST", "/api/connectorattributevalues/Create", oJson:ToJson())
    EndIf
Return (oResp != Nil)

// Extrai o "data" do envelope; array vazio em falha (motivo em ::cLastError)
Method GetData(cVerb, cPath) Class IntegrationPlatformClient
    Local oResp := ::DoRequest(cVerb, cPath, "")
    Local aRet  := {}

    If oResp != Nil .And. oResp["data"] != Nil
        aRet := oResp["data"]
    EndIf
Return aRet

// POST/PUT usam as funcoes nativas porque o FWRest devolve corpo vazio nesses
// verbos; o GET continua no FWRest.
Method DoRequest(cVerb, cPath, cBody) Class IntegrationPlatformClient
    Local oRest
    Local aHeader  := {}
    Local oResp    := JsonObject():New()
    Local cResult  := ""
    Local cUrl     := ::cBaseUrl + cPath
    Local cHttpDsc := ""
    Local nStatus  := 0
    Local lOk      := .F.

    aAdd(aHeader, "X-Api-Key: " + ::cApiKey)
    aAdd(aHeader, "Content-Type: application/json")
    aAdd(aHeader, "Accept: application/json")

    Do Case
    Case Upper(cVerb) == "GET"
        oRest := FWRest():New(::cBaseUrl)
        oRest:SetPath(cPath)
        lOk     := oRest:Get(aHeader)
        cResult := oRest:cResult

    Case Upper(cVerb) == "POST"
        cResult := HTTPPost(cUrl, "", cBody, 60, aHeader)
        nStatus := HTTPGetStatus(@cHttpDsc)
        lOk     := (nStatus >= 200 .And. nStatus < 300)

    Case Upper(cVerb) == "PUT"
        cResult := HTTPQuote(cUrl, "PUT", "", cBody, 60, aHeader)
        nStatus := HTTPGetStatus(@cHttpDsc)
        lOk     := (nStatus >= 200 .And. nStatus < 300)
    EndCase


    ::cLastError := ""

    If lOk
        If !Empty(cResult) .And. oResp:FromJson(cResult) == Nil
            Return oResp
        EndIf
        // 2xx sem corpo (ex: 204) ainda e sucesso
        Return JsonObject():New()
    EndIf

    ::cLastError := ::ErrorFrom(cResult)
Return Nil

// Mensagem de erro a partir do corpo. O traceId vai junto por permitir localizar
// a falha no log da API.
Method ErrorFrom(cBody) Class IntegrationPlatformClient
    Local oJson   := JsonObject():New()
    Local oErrors
    Local cMsg    := ""
    Local cTrace  := ""
    Local nStatus := 0

    If Empty(cBody)
        Return "Sem resposta da IntegrationPlatform (verifique ZZ_CTIURL/ZZ_CTIKEY e se a API esta no ar)"
    EndIf

    If oJson:FromJson(cBody) != Nil
        Return "Resposta nao e JSON. Corpo: " + SubStr(cBody, 1, 400)
    EndIf

    cMsg := oJson:GetJsonText("message")

    If oJson:HasProperty("errors")
        oErrors := oJson["errors"]
        If ValType(oErrors) == "O"
            cTrace := oErrors:GetJsonText("traceId")
            If oErrors:HasProperty("status") .And. ValType(oErrors["status"]) == "N"
                nStatus := oErrors["status"]
            EndIf
            If Empty(cMsg)
                cMsg := oErrors:GetJsonText("detail")
            EndIf
        EndIf
    EndIf

    If Empty(cMsg)
        cMsg := SubStr(cBody, 1, 400)
    EndIf

    If nStatus > 0
        cMsg := "HTTP " + cValToChar(nStatus) + " - " + cMsg
    EndIf

    If !Empty(cTrace)
        cMsg += CRLF + CRLF + "traceId: " + cTrace
    EndIf
Return cMsg
