#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.cti

// Cliente REST da IntegrationPlatform. Le ZZ_CTIURL/ZZ_CTIKEY por filial.
// Toda resposta vem no envelope {message,data,errors,pagination}.
Class IntegrationPlatformClient

    Private Data cBaseUrl   as Character
    Private Data cApiKey    as Character
    Public  Data cLastError as Character

    Public Method New() Constructor

    Public Method GetActiveCategories() as Array
    Public Method GetIntegrationsByCategory(nCategoryId as Numeric) as Array
    Public Method GetAttributesByIntegration(nIntegrationId as Numeric) as Array
    Public Method GetActiveConnectors() as Array
    Public Method CreateConnector(nIntegrationId as Numeric, cName as Character, cSystemApplicationId as Character) as Numeric
    Public Method UpdateConnector(nConnectorId as Numeric, nIntegrationId as Numeric, cName as Character, lActive as Logical) as Logical
    Public Method SaveConnectorAttributeValue(nConnectorId as Numeric, nIntegrationAttributeId as Numeric, cValue as Character, nExistingValueId as Numeric) as Logical
    Public Method GetConnectorAttributeValuesByConnector(nConnectorId as Numeric) as Array

    Private Method DoRequest(cVerb as Character, cPath as Character, cBody as Character) as Object

EndClass

Method New() Class IntegrationPlatformClient
    ::cBaseUrl   := AllTrim(SuperGetMV("ZZ_CTIURL", .F., ""))
    ::cApiKey    := AllTrim(SuperGetMV("ZZ_CTIKEY", .F., ""))
    ::cLastError := ""
Return Self

// GET /api/integrationcategories/active
Method GetActiveCategories() Class IntegrationPlatformClient
    Local oResp := ::DoRequest("GET", "/api/integrationcategories/active", "")
    Local aRet  := {}
    If oResp != Nil
        aRet := oResp:GetJsonObject("data")
    EndIf
Return aRet

// GET /api/integrations/category/{id}
Method GetIntegrationsByCategory(nCategoryId) Class IntegrationPlatformClient
    Local oResp := ::DoRequest("GET", "/api/integrations/category/" + cValToChar(nCategoryId), "")
    Local aRet  := {}
    If oResp != Nil
        aRet := oResp:GetJsonObject("data")
    EndIf
Return aRet

// GET /api/integrationattributes/integration/{id}
// "type" e o FieldType numerico: 1=Texto 2=TextoLongo 3=Numero 4=Decimal
// 5=Logico 6=Data 7=DataHora 8=Lista 9=Arquivo
Method GetAttributesByIntegration(nIntegrationId) Class IntegrationPlatformClient
    Local oResp := ::DoRequest("GET", "/api/integrationattributes/integration/" + cValToChar(nIntegrationId), "")
    Local aRet  := {}
    If oResp != Nil
        aRet := oResp:GetJsonObject("data")
    EndIf
Return aRet

// GET /api/connectors/active
Method GetActiveConnectors() Class IntegrationPlatformClient
    Local oResp := ::DoRequest("GET", "/api/connectors/active", "")
    Local aRet  := {}
    If oResp != Nil
        aRet := oResp:GetJsonObject("data")
    EndIf
Return aRet

// POST /api/connectors -> Id criado, ou 0 em falha (::cLastError)
Method CreateConnector(nIntegrationId, cName, cSystemApplicationId) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()
    Local oResp
    Local nId   := 0

    Default cSystemApplicationId := ""

    oJson["integrationId"] := nIntegrationId
    oJson["name"]          := cName
    If !Empty(cSystemApplicationId)
        oJson["systemApplicationId"] := cSystemApplicationId
    EndIf

    oResp := ::DoRequest("POST", "/api/connectors", oJson:ToJson())
    If oResp != Nil
        nId := Val(oResp:GetJsonObject("data"):GetJsonText("id"))
    EndIf
Return nId

// PUT /api/connectors/{id}
Method UpdateConnector(nConnectorId, nIntegrationId, cName, lActive) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()
    Local oResp

    oJson["id"]            := nConnectorId
    oJson["integrationId"] := nIntegrationId
    oJson["name"]          := cName
    oJson["isActive"]      := lActive

    oResp := ::DoRequest("PUT", "/api/connectors/" + cValToChar(nConnectorId), oJson:ToJson())
Return (oResp != Nil)

Method SaveConnectorAttributeValue(nConnectorId, nIntegrationAttributeId, cValue, nExistingValueId) Class IntegrationPlatformClient
    Local oJson := JsonObject():New()
    Local oResp

    Default nExistingValueId := 0

    If nExistingValueId > 0
        oJson["id"]                     := nExistingValueId
        oJson["integrationAttributeId"] := nIntegrationAttributeId
        oJson["value"]                  := cValue
        oResp := ::DoRequest("PUT", "/api/connectorattributevalues/" + cValToChar(nExistingValueId), oJson:ToJson())
    Else
        oJson["connectorId"]            := nConnectorId
        oJson["integrationAttributeId"] := nIntegrationAttributeId
        oJson["value"]                  := cValue
        oResp := ::DoRequest("POST", "/api/connectorattributevalues", oJson:ToJson())
    EndIf
Return (oResp != Nil)

// GET /api/connectorattributevalues/connector/{id} - pre-carrega o form na edicao
Method GetConnectorAttributeValuesByConnector(nConnectorId) Class IntegrationPlatformClient
    Local oResp := ::DoRequest("GET", "/api/connectorattributevalues/connector/" + cValToChar(nConnectorId), "")
    Local aRet  := {}
    If oResp != Nil
        aRet := oResp:GetJsonObject("data")
    EndIf
Return aRet

// TODO smoke test: confirmar contra a API real se oRest:Get/Post/Put ja
// refletem 2xx vs 4xx/5xx corretamente, e se oRest:cResult e a propriedade
// certa de corpo de resposta da FWRest nesta versao de Protheus.
Method DoRequest(cVerb, cPath, cBody) Class IntegrationPlatformClient
    Local oRest   := FWRest():New(::cBaseUrl)
    Local aHeader := {}
    Local lOk     := .F.
    Local oResp   := JsonObject():New()

    aAdd(aHeader, "X-Api-Key: " + ::cApiKey)
    aAdd(aHeader, "Content-Type: application/json")
    aAdd(aHeader, "Accept: application/json")

    oRest:SetPath(cPath)

    Do Case
    Case Upper(cVerb) == "GET"
        lOk := oRest:Get(aHeader)
    Case Upper(cVerb) == "POST"
        oRest:SetPostParams(cBody)
        lOk := oRest:Post(aHeader)
    Case Upper(cVerb) == "PUT"
        oRest:SetPostParams(cBody)
        lOk := oRest:Put(aHeader)
    EndCase

    ::cLastError := ""

    If lOk .And. !Empty(oRest:cResult)
        If oResp:FromJson(oRest:cResult) == Nil
            Return oResp
        Else
            ::cLastError := "Falha ao interpretar a resposta da IntegrationPlatform"
            Return Nil
        EndIf
    EndIf

    If !Empty(oRest:cResult) .And. oResp:FromJson(oRest:cResult) == Nil
        ::cLastError := oResp:GetJsonText("message")
    EndIf

    If Empty(::cLastError)
        ::cLastError := "Falha de comunicacao com a IntegrationPlatform (verifique ZZ_CTIURL/ZZ_CTIKEY)"
    EndIf
Return Nil
