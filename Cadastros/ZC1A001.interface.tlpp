#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"

namespace custom.cti.zc1a001

// Interface Smart X da ZC1 - browse + inclusao/edicao/visualizacao.
@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Referencia de Conector por Finalidade")

class Interface

    private data oInterface  as object
    private data oDataView   as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object

    public method new()         as object
    public method setInterface()
    public method getContract() as json

endClass

method new() as object class Interface
return self

method setInterface() class Interface
    local cIdentifier := "zc1a001" as character

    ::oInterface := totvs.framework.structure.interface.BuildContract():new(cIdentifier)
    ::oInterface:setTitle("Referencia de Conector por Finalidade")
    ::oInterface:setModelId("custom.cti.zc1a001.model", .F.)
    ::oInterface:setVersion("1.0")

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("zc1a001View", "custom.cti.zc1a001.model")
    ::oDataView:setModelId("custom.cti.zc1a001.model", .T.)
    ::oDataView:setTitle("Referencia de Conector por Finalidade")
    // Legenda de cores a partir do combo ZC1_ATIVO (S/N)
    ::oDataView:setFieldAsLabel("ZC1", "ZC1_ATIVO")
    ::oDataView:assignInvisibleFields()

    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("zc1a001New", "custom.cti.zc1a001.model")
    ::oDataNew:setTitle("Incluir Referencia de Conector")

    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("zc1a001Edit", "custom.cti.zc1a001.model")
    ::oDataEdit:setTitle("Editar Referencia de Conector")

    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("zc1a001Detail", "custom.cti.zc1a001.model")
    ::oDataDetail:setTitle("Visualizar Referencia de Conector")

    ::oInterface:setDataView(::oDataView:getDataView())
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .F.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit())
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .F.)
return

method getContract() as json class Interface
return ::oInterface:getContract()
