#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.Interface.th"

namespace custom.cti.zc1a001

/*/{Protheus.doc} Interface
    Interface Smart X da rotina ZC1A001 - Referência de Conector por
    Finalidade. Define o contrato de UI (browse + inclusão + edição +
    visualização) da manutenção CRUD da tabela customizada ZC1, referenciando
    o Model custom.cti.zc1a001.model.

    Nenhum evento é definido nesta classe - eventos (incluindo o gatilho de
    busca de conector) são definidos exclusivamente no Model, conforme padrão
    Smart X (única exceção seria onKeyDown, não utilizado nesta rotina).
    @type Class
    @author pivetorogerio@gmail.com
    @since 17/08/2026
/*/
@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Referência de Conector por Finalidade")

class Interface

    private data oInterface  as object
    private data oDataView   as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object

    public method new()         as object
    public method setInterface()
    public method getContract() as json

endClass

/*/{Protheus.doc} new
    Construtor da Interface ZC1A001.
    @type Method
    @author pivetorogerio@gmail.com
    @since 17/08/2026
    @return Object, instância da Interface
/*/
method new() as object class Interface
return self

/*/{Protheus.doc} setInterface
    Monta o contrato de interface: browse (dataView), formulário de
    inclusão (dataNew), formulário de edição (dataEdit) e formulário de
    visualização (dataDetail), todos referenciando o Model
    custom.cti.zc1a001.model.
    @type Method
    @author pivetorogerio@gmail.com
    @since 17/08/2026
/*/
method setInterface() class Interface
    local cIdentifier := "zc1a001" as character

    // Contrato principal
    ::oInterface := totvs.framework.structure.interface.BuildContract():new(cIdentifier)
    ::oInterface:setTitle("Referência de Conector por Finalidade")
    ::oInterface:setModelId("custom.cti.zc1a001.model", .F.)
    ::oInterface:setVersion("1.0")

    // Browse (listagem)
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("zc1a001View", "custom.cti.zc1a001.model")
    ::oDataView:setModelId("custom.cti.zc1a001.model", .T.)
    ::oDataView:setTitle("Referência de Conector por Finalidade")
    // Legenda automática de cores para o combo ZC1_ATIVO (S/N), conforme SX3
    ::oDataView:setFieldAsLabel("ZC1", "ZC1_ATIVO")
    // Aplica a visibilidade padrão de campos conforme X3_BROWSE do dicionário
    ::oDataView:assignInvisibleFields()

    // Formulário de inclusão
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("zc1a001New", "custom.cti.zc1a001.model")
    ::oDataNew:setTitle("Incluir Referência de Conector")

    // Formulário de edição
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("zc1a001Edit", "custom.cti.zc1a001.model")
    ::oDataEdit:setTitle("Editar Referência de Conector")

    // Formulário de visualização
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("zc1a001Detail", "custom.cti.zc1a001.model")
    ::oDataDetail:setTitle("Visualizar Referência de Conector")

    // Monta contrato final
    ::oInterface:setDataView(::oDataView:getDataView())
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .F.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit())
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .F.)
return

/*/{Protheus.doc} getContract
    Retorna o contrato JSON final da Interface, consumido pelo Launcher.
    @type Method
    @author pivetorogerio@gmail.com
    @since 17/08/2026
    @return Json, contrato da interface
/*/
method getContract() as json class Interface
return ::oInterface:getContract()
