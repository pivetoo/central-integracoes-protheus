#include "protheus.ch"

namespace custom.cti.zc1a001

// Launcher de menu da rotina Smart X ZC1A001 (Referencia de Conector por Finalidade).
User Function ZC1A001()
    Local oLauncher as Object

    oLauncher := totvs.framework.application.smartx.launcher():new()
    oLauncher:setInterface("custom.cti.zc1a001.interface")
    oLauncher:open()
Return Nil
