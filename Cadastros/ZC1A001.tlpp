#include "protheus.ch"

// Sem namespace de proposito: User Function dentro de namespace nao se registra
// como U_NOME global e o menu nao consegue chamar. O Model e a Interface mantem
// o namespace deles e sao referenciados pelo nome completo.
User Function ZC1A001()
    Local oLauncher as Object

    oLauncher := totvs.framework.application.smartx.launcher():new()
    oLauncher:setInterface("custom.cti.zc1a001.interface")
    oLauncher:open()
Return Nil
